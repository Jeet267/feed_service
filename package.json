{
  "name": "hyperlocal-feed-service",
  "version": "1.0.0",
  "description": "Location-aware feed API: geo queries on MongoDB 2dsphere, Redis-cached trending feed, Redis rate limiting, Prometheus metrics.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "explain": "node scripts/explain.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.9.0",
    "ngeohash": "^0.6.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000
  }
}
