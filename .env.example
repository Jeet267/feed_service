PORT=3000
MONGO_URI=mongodb://localhost:27017/hyperlocal
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TRENDING_CACHE_TTL_SEC=60
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=100
RATE_LIMIT_WRITE_MAX=20

# Cloud (Atlas + Upstash) example:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/hyperlocal?retryWrites=true&w=majority
# REDIS_URL=rediss://default:PASS@xxxx.upstash.io:6379
# MONGO_POOL_SIZE=5
# CORS_ORIGINS=*   (only needed if frontend is on a different domain)
